# Environment Variables
#
# IMPORTANT: All client-side variables must be prefixed with VITE_
# Variables without VITE_ prefix are only available at build time and not
# exposed to the browser bundle.
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production (Vercel), set these in Project Settings → Environment
# Variables, then redeploy WITHOUT "Use existing Build Cache" so Vite
# re-bakes VITE_* vars into the bundle.

# API Configuration
# Origin only. No trailing slash. No /api suffix — apiClient appends it.
# Local dev:   http://localhost:3001     (matches backend PORT)
# Production:  https://<your-backend>.zeabur.app
VITE_API_URL=http://localhost:3001

# Application Settings (optional)
# VITE_APP_TITLE=My App
# VITE_APP_DESCRIPTION=My awesome application

# Feature Flags (optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false

# ============================================================================
# SYSTEM ENVIRONMENT OVERRIDE
# ============================================================================
# System env (e.g., Vercel's env vars, docker run -e) takes precedence over
# .env file values. Configured in vite.config.ts:
#
#   const env = { ...fileEnv, ...process.env };
#
# Vite BAKES VITE_* vars at build time. Changing them on Vercel without
# rebuilding has no effect on the deployed bundle.
