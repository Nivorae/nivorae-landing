# Backend environment variables.
# Local: copy to backend/.env and fill in the blanks.
# Production (Zeabur): set these in the service's Variables tab.

# Server
NODE_ENV=development
PORT=3001

# Database (Postgres)
# Local: docker-compose maps Postgres to host port 5434.
# Production: bind to ${POSTGRES_CONNECTION_STRING} from the Zeabur Postgres service.
DATABASE_URL=postgresql://dev:dev@localhost:5434/myapp

# CORS / Frontend origin
# Browser Origin headers NEVER have trailing slashes — match exactly.
# Local: http://localhost:5173
# Production: https://<your-frontend>.vercel.app
CLIENT_URL=http://localhost:5173

# Redis (optional — uncomment only if your app uses Redis)
# Local: docker-compose up redis, then use redis://localhost:6379
# Production (Zeabur, same project): redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
# REDIS_URL=redis://localhost:6379
